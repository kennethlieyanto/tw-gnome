<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.taskwarrior" path="/org/gnome/shell/extensions/taskwarrior/">
    <key name="refresh-interval" type="i">
      <default>30</default>
      <summary>Refresh interval</summary>
      <description>Seconds between Taskwarrior refreshes.</description>
    </key>
    <key name="panel-max-length" type="i">
      <default>32</default>
      <summary>Maximum panel task length</summary>
      <description>Maximum number of characters shown for the panel task.</description>
    </key>
    <key name="show-metadata" type="b">
      <default>true</default>
      <summary>Show task metadata</summary>
      <description>Show project, tags, and due date in the popup.</description>
    </key>
  </schema>
</schemalist>
